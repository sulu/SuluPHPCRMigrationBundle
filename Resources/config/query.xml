<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="sulu_phpcr_migration.update_access_control_entity_class_query"
                 class="Sulu\Bundle\PhpcrMigrationBundle\PhpcrMigration\Application\Query\UpdateAccessControlEntityClassQuery">
            <tag name="sulu_phpcr_migration.post_migration_query"/>
        </service>

        <service id="sulu_phpcr_migration.migrate_permission_contexts_query"
                 class="Sulu\Bundle\PhpcrMigrationBundle\PhpcrMigration\Application\Query\MigratePermissionContextsQuery">
            <argument type="service" id="sulu_phpcr_migration.entity_repository"/>
            <tag name="sulu_phpcr_migration.post_migration_query"/>
        </service>
    </services>
</container>
