<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">

    <key>global_media</key>

    <meta>
        <title lang="en">Global Media</title>
        <title lang="de">Globale Medien</title>
    </meta>

    <properties>
        <property name="title" type="text_line">
            <meta>
                <title lang="en">Title</title>
                <title lang="de">Titel</title>
            </meta>
        </property>
        <property name="globalSmartContentMedia" type="smart_content">
            <meta>
                <title lang="en">Smart Content</title>
                <title lang="de">Smart Content</title>
            </meta>
            <params>
                <param name="provider" value="media"/>
                <param name="max_per_page" value="10"/>
            </params>
        </property>
    </properties>
</template>
